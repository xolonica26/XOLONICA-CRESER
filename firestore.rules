rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.email == 'byoscarelieser@gmail.com' || request.auth.token.email == 'xolonica26@gmail.com'); }
    function isAuditorOrAdmin() { return isAdmin() || (signedIn() && (request.auth.token.email.matches('.*auditor.*') || request.auth.token.email == 'auditoria@creser.org')); }
    function owns(email) { return signedIn() && request.auth.token.email == email; }

    match /users/{userId} {
      allow get: if owns(resource.data.email) || isAdmin();
      allow create: if owns(request.resource.data.email);
      allow update: if isAdmin() || (owns(resource.data.email) && owns(request.resource.data.email));
      allow delete: if false;
    }
    match /mood_logs/{logId} {
      allow get, list: if owns(resource.data.userEmail);
      allow create: if owns(request.resource.data.userEmail);
      allow update, delete: if owns(resource.data.userEmail) && owns(request.resource.data.userEmail);
    }
    match /journal_entries/{entryId} {
      allow get, list: if owns(resource.data.userEmail);
      allow create: if owns(request.resource.data.userEmail);
      allow update, delete: if owns(resource.data.userEmail) && owns(request.resource.data.userEmail);
    }
    match /resources/{resourceId} { allow read: if true; allow write: if isAdmin(); }
    match /emergency_contacts/{contactId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_content/{contentId} { allow read: if true; allow write: if isAdmin(); }
    match /community_posts/{postId} { allow read: if true; allow create: if signedIn(); allow update, delete: if isAdmin(); }
    match /audit_logs/{logId} { allow read: if isAuditorOrAdmin(); allow create: if signedIn() && owns(request.resource.data.usuario); allow update, delete: if false; }
    match /system/{configDoc} { allow read: if true; allow write: if isAdmin(); }
  }
}
